# Polymarket CLOB Client 环境变量
# 复制此文件为 .env 并填入你的值
# 永远不要提交 .env 文件！

# =============================================================================
# 必需配置 - 钱包和认证
# =============================================================================

# 你的 Polygon 钱包私钥（不带 0x 前缀）
# 用于签名交易和订单
# 警告：这是敏感信息，请妥善保管！
POLY_PRIVATE_KEY=

# Polymarket API 凭证
# 可通过 L1 认证获取，或使用 Polymarket 客户端生成
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# =============================================================================
# 市场配置
# =============================================================================

# YES Token ID
# 从 Polymarket 市场页面获取
# 示例: 123456789012345678901234567890123456789012345678901234567890123456
POLY_YES_TOKEN=

# NO Token ID
# 从 Polymarket 市场页面获取
POLY_NO_TOKEN=

# 市场 Condition ID
# 从 Polymarket 市场页面获取
POLY_CONDITION_ID=

# =============================================================================
# 网络配置
# =============================================================================

# Polymarket CLOB API 端点
# 默认: https://clob.polymarket.com
CLOB_API_URL=https://clob.polymarket.com

# 是否使用测试网
# true: 使用 Polygon Amoy 测试网 (Chain ID: 80002)
# false: 使用 Polygon 主网 (Chain ID: 137)
# 默认: false
POLY_USE_TESTNET=false

# Polygon 链 ID (如果需要手动指定)
# 主网: 137, 测试网: 80002 (Amoy)
# 默认根据 POLY_USE_TESTNET 自动设置
# POLYGON_CHAIN_ID=137

# 代理/资金地址（如果使用 Magic/Email 钱包）
# 这是你在 Polymarket 上存放 USDC 的地址
# FUNDER_ADDRESS=

# 签名类型
# 0: EOA（MetaMask、硬件钱包等）
# 1: Magic/Email 钱包
# 2: 浏览器钱包代理
# 默认: 0
SIGNATURE_TYPE=0

# =============================================================================
# 策略参数 - BTC 对冲策略
# =============================================================================

# 累计买入目标 (0-1)
# 值越小越保守，只在极低价时重仓
# 推荐: 0.3 (保守) - 0.6 (激进)
# 默认: 0.3
STRATEGY_SUM_TARGET=0.3

# 触发监控的价格下跌幅度 (0-1)
# 例如 0.01 表示价格下跌 1% 时开始监控
# 默认: 0.01
STRATEGY_MOVE_THRESHOLD=0.01

# 最低买入价格阈值 (0-1)
# 价格低于此值才考虑买入
# 默认: 0.15
STRATEGY_MIN_BUY_PRICE=0.15

# 对冲触发的最小价差 (0-1)
# 当前价格 - 买入均价 > 此值时触发对冲
# 默认: 0.05
STRATEGY_HEDGE_SPREAD=0.05

# 单次最大买入金额 (USDC)
# 默认: 100.0
STRATEGY_MAX_POSITION=100.0

# 价格监控间隔 (毫秒)
# 默认: 500
STRATEGY_POLL_INTERVAL=500

# =============================================================================
# 开发配置
# =============================================================================

# 日志级别: debug, info, warn, error
# 默认: info
LOG_LEVEL=info

# =============================================================================
# 如何获取 Token ID 和 Condition ID
# =============================================================================
#
# 方法一: 使用 Polymarket API
#   1. 访问 https://gamma-api.polymarket.com/markets
#   2. 找到你感兴趣的市场
#   3. 获取 clob_token_ids 和 condition_id
#
# 方法二: 使用浏览器开发者工具
#   1. 访问 Polymarket 市场页面
#   2. 打开浏览器开发者工具 (F12)
#   3. 在 Network 标签中找到 API 请求
#   4. 查找包含 token_id 的响应
#
# 方法三: 使用本 SDK 的公共 API
#   const markets = try client.getMarkets(.{});
#   for (markets.value) |market| {
#       // 使用 market.tokens 获取 token_id
#   }
#
# =============================================================================
# 安全提示
# =============================================================================
#
# 1. 永远不要将 .env 文件提交到版本控制
# 2. 使用 .gitignore 排除 .env 文件
# 3. 在生产环境使用更安全的密钥管理方案
# 4. 定期轮换 API 密钥
# 5. 建议先在测试网验证策略
#
